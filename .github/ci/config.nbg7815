# Zusatz nur fuer den nbg7815-Leg (Zyxel NBG7815), Basis master.
# Wird nach config.wwand an .config angehaengt (build-images.sh, ueber $SLUG).
#
# Bluetooth: der PR-Branch (openwrt#24881) nimmt bluez bewusst aus
# DEVICE_PACKAGES, weil bluez kein Kernpaket ist; ohne hciattach (bluez-utils)
# und bluetoothd (bluez-daemon) bleibt der Dienst nbg7815-bluetooth unten. Das
# Test-Image soll ihn aber gleich laufen lassen, damit der hwtest nicht erst
# nachinstallieren muss (und ein frisch installiertes bluez-daemon braucht
# ohnehin einen Neustart, bis bluetoothd auf den D-Bus kommt).
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-daemon=y
# Die PSKEY-Kopie aus dem Stock-Slot laeuft nur mit unsquashfs: der Kernel
# mountet das Stock-squashfs nicht (seine xz-Optionen weist
# squashfs_xz_comp_opts() zurueck, laut strrs' Commit 93e5c73, 2026-10-28).
CONFIG_PACKAGE_squashfs-tools-unsquashfs=y
