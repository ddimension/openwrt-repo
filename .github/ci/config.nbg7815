# Addition for the nbg7815 leg only (Zyxel NBG7815), base master.
# Appended to .config after config.wwand (build-images.sh, via $SLUG).
#
# Bluetooth: the PR branch (openwrt#24881) keeps bluez out of DEVICE_PACKAGES on
# purpose, because bluez is not a core package; without hciattach (bluez-utils)
# and bluetoothd (bluez-daemon) the nbg7815-bluetooth service stays down. The
# test image should run it right away, so hwtest does not have to install it
# first (and a freshly installed bluez-daemon needs a reboot anyway before
# bluetoothd gets onto D-Bus).
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-daemon=y
# The PSKEY copy from the stock slot only works with unsquashfs: the kernel
# does not mount the stock squashfs (squashfs_xz_comp_opts() rejects its xz
# options, per strrs' commit 93e5c73, 2026-10-28).
CONFIG_PACKAGE_squashfs-tools-unsquashfs=y
