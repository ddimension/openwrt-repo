# Addition for the chateau leg only (MikroTik Chateau 5G R17 ax), both bases.
# Appended to .config after config.wwand (build-images.sh, via $SLUG).
#
# FTDI USB serial: as a gateway the Chateau also serves serial devices
# (FT232/FT2232 adapters). The module is built into the image so that a
# plugged-in cable shows up as /dev/ttyUSB* without installing anything.
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
# usb-modeswitch: the second modem on the test Chateau, a Huawei E392, comes up
# as mass storage (12d1:1505) and only becomes a modem (12d1:1506) once
# usbmode switches it; without it wwand waits for that modem forever (HW, image
# r0-f91237f, 2026-11-09).
CONFIG_PACKAGE_usb-modeswitch=y
