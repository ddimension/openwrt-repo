# Kompletter wwand-Stack ins Image (built-in). Wird an .config angehaengt.
CONFIG_PACKAGE_wwand=y
CONFIG_PACKAGE_wwand-qmi=y
CONFIG_PACKAGE_wwand-mbim=y
CONFIG_PACKAGE_wwand-ncm=y
CONFIG_PACKAGE_wwand-mhi=y
# wwand coexists with the stock WWAN stack (no CONFLICTS). uqmi is left out only
# to keep the image lean — with both in, defconfig would drop wwand-qmi to =m.
# CONFIG_PACKAGE_uqmi is not set
CONFIG_PACKAGE_wwand-lpac=y
# eSIM (eUICC) profile management. wwand-lpac alone only provides the lpac
# binary -- without wwand-esim the esim.uc/esim_bridge.uc backend is missing and
# the LuCI eSIM page has nothing to talk to. Depends on wwand-qmi (APDU over the
# modem UIM channel) and on the virtual lpac, satisfied by wwand-lpac above.
CONFIG_PACKAGE_wwand-esim=y
CONFIG_PACKAGE_luci-app-wwand=y
CONFIG_PACKAGE_luci-proto-wwand=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-rmnet=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-vrf=y
CONFIG_LIBQMI_WITH_MBIM_QMUX=y
# The feed's address and key: a flashed device follows the stable channel of
# this feed right away, `apk upgrade` included. Built from the image's own
# checkout of the feed, it points at stable/<release>/<arch> (the default
# channel; release and arch come from the buildroot).
CONFIG_PACKAGE_ddimension-feed=y
# ...and not a second time through distfeeds.list: the buildroot would list
# the wwand feed as .../packages/<arch>/wwand/ on downloads.openwrt.org, which
# does not exist, and every `apk update` on the device would say so.
# CONFIG_FEED_wwand is not set
