# The complete wwand stack in the image (built-in). Appended to .config.
CONFIG_PACKAGE_wwand=y
CONFIG_PACKAGE_wwand-qmi=y
CONFIG_PACKAGE_wwand-mbim=y
CONFIG_PACKAGE_wwand-ncm=y
CONFIG_PACKAGE_wwand-mhi=y
# wwand coexists with the stock WWAN stack (no CONFLICTS). uqmi is left out only
# to keep the image lean — with both in, defconfig would drop wwand-qmi to =m.
# CONFIG_PACKAGE_uqmi is not set
CONFIG_PACKAGE_wwand-lpac=y
# eSIM (eUICC) profile management. wwand-lpac alone only provides the lpac
# binary -- without wwand-esim the esim.uc/esim_bridge.uc backend is missing and
# the LuCI eSIM page has nothing to talk to. Depends on wwand-qmi (APDU over the
# modem UIM channel) and on the virtual lpac, satisfied by wwand-lpac above.
CONFIG_PACKAGE_wwand-esim=y
CONFIG_PACKAGE_luci-app-wwand=y
CONFIG_PACKAGE_luci-proto-wwand=y
CONFIG_PACKAGE_luci=y
# lldpd: the test devices sit in the test network without a console (no serial
# on most without opening the case); over LLDP a device still announces itself
# to the switch when its LAN address no longer matches after an upgrade.
CONFIG_PACKAGE_lldpd=y
# VoLTE for a LAN SIP phone (wwand-ims: the router as its own IMS UE). What
# it needs from the kernel is built in, because a CI image has no kmod
# repository to install it from later: IPsec (kmod-ipsec, -ipsec4, -ipsec6)
# and the null cipher, which IMS networks commonly pick for ESP and
# kmod-ipsec does not pull in (ecb(cipher_null), wwand-ims ue/secagree.uc);
# kmod-vrf is below. ip-full and ucode-mod-socket are its userland. wwand-ims
# itself is NOT in the image: 0.1.1 installs its example config active — sipd
# on the LAN with the example's extension and password — so it is installed on
# purpose (`apk add wwand-ims`), with a configuration of one's own.
CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-ipsec4=y
CONFIG_PACKAGE_kmod-ipsec6=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ucode-mod-socket=y
# Tools for the bench: a capture (tcpdump), and what is plugged in (lspci,
# lsusb) — the questions the first look at a misbehaving modem starts with.
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-rmnet=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-vrf=y
CONFIG_LIBQMI_WITH_MBIM_QMUX=y
# The feed's address and key: a flashed device follows the stable channel of
# this feed right away, `apk upgrade` included. Built from the image's own
# checkout of the feed, it points at stable/<release>/<arch> (the default
# channel; release and arch come from the buildroot).
CONFIG_PACKAGE_ddimension-feed=y
# ...and not a second time through distfeeds.list: the buildroot would list
# the wwand feed as .../packages/<arch>/wwand/ on downloads.openwrt.org, which
# does not exist, and every `apk update` on the device would say so.
# CONFIG_FEED_wwand is not set
# VoWiFi (wwand-ims-vowifi): an IKEv2 tunnel to the operator's ePDG with
# EAP-AKA through the USIM, P-CSCF from the ePDG, the tunnel as an XFRM
# interface in the IMS VRF. strongSwan from THIS feed (strongswan/README.md:
# the packages feed builds no eap-aka and no p-cscf; build-images.sh forces
# this feed's copy). Picked by plugin, not strongswan-minimal: that one pulls
# stroke and updown, and with them iptables. charon is driven over its vici
# interface only (connections, keys and the card all at run time from
# wwand-ims-vowifi), no configuration of its own. swanctl is in for debugging
# (swanctl --list-sas, --log); its init starts an idle charon at boot (no
# connections from an empty /etc/config/ipsec, IKE ports 500/4500 open, the
# WAN firewall drops them).
# the base package first: every strongswan-* has a plain `DEPENDS:= strongswan`
# (no +), so without it defconfig drops them all (SDK, 2026-11-21)
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-mod-vici=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=y
CONFIG_PACKAGE_strongswan-mod-socket-default=y
CONFIG_PACKAGE_strongswan-mod-random=y
CONFIG_PACKAGE_strongswan-mod-kdf=y
CONFIG_PACKAGE_strongswan-mod-aes=y
CONFIG_PACKAGE_strongswan-mod-gcm=y
CONFIG_PACKAGE_strongswan-mod-sha1=y
CONFIG_PACKAGE_strongswan-mod-sha2=y
CONFIG_PACKAGE_strongswan-mod-hmac=y
CONFIG_PACKAGE_strongswan-mod-mgf1=y
CONFIG_PACKAGE_strongswan-mod-gmp=y
CONFIG_PACKAGE_strongswan-mod-curve25519=y
CONFIG_PACKAGE_strongswan-mod-x509=y
CONFIG_PACKAGE_strongswan-mod-pubkey=y
CONFIG_PACKAGE_strongswan-mod-pkcs1=y
CONFIG_PACKAGE_strongswan-mod-pem=y
CONFIG_PACKAGE_strongswan-mod-constraints=y
CONFIG_PACKAGE_strongswan-mod-eap-identity=y
CONFIG_PACKAGE_strongswan-mod-eap-aka=y
CONFIG_PACKAGE_strongswan-mod-ext-aka=y
CONFIG_PACKAGE_strongswan-mod-eap-simaka-pseudonym=y
CONFIG_PACKAGE_strongswan-mod-eap-simaka-reauth=y
CONFIG_PACKAGE_strongswan-mod-p-cscf=y
CONFIG_PACKAGE_kmod-xfrm-interface=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
