--- a/Makefile
+++ b/Makefile
@@ -7,6 +7,15 @@
 NDK_APPLICATION_MK=Application.mk
 NDK_OUT=out
 
+# Respect a toolchain handed in by the caller; fall back to CROSS_COMPILE.
+# CC/CXX carry make's built-in defaults, so ?= would never fire here.
+ifeq ($(origin CC),default)
+CC := $(CROSS_COMPILE)gcc
+endif
+ifeq ($(origin CXX),default)
+CXX := $(CROSS_COMPILE)g++
+endif
+
 #CFLAGS+=-Wall
 #CFLAGS+=-O2
 #CFLAGS+=-Wmissing-declarations
@@ -67,16 +76,16 @@
 
