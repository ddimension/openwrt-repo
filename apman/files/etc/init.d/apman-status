#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	local enabled=$(uci get apman.main.enabled)
	if [ -z "$enabled" ] || [ "$enabled" == "0" ]; then
		return 0
	fi
	procd_open_instance
	procd_set_param command \
		/usr/bin/apman-status
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Take the hostapd control sockets with us.
#
# The agent binds one reply socket per bss, named apman-mon-<pid>-<bss>, and
# procd stops it with a signal it cannot act on: uloop.signal() registers on
# this build but never calls back, and registering it would also keep the
# process alive through SIGTERM. So the cleanup belongs here, where it works.
#
# Not doing it is not fatal — ctrl_cleanup_stale() removes every socket that
# does not carry the running pid on the next start — but the files would
# otherwise sit in /var/run for as long as the service is stopped, and hostapd
# would keep a monitor that has nobody behind it.
stop_service() {
	local dir
	for dir in /var/run/hostapd /var/run/hostapd-*; do
		[ -d "$dir" ] || continue
		rm -f "$dir"/apman-mon-* 2>/dev/null
	done
}
