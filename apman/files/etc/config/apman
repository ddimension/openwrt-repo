config apman 'main'
	option url_event 'http://192.168.203.38/apman/api/device/event'
	option url_status 'http://192.168.203.38/apman/api/device/status'
	option enabled '0'
	option mqtt_password ''
	option mqtt_username ''
	option tls_insecure ''
	option tls_version ''
	option url_event ''
	option cafile ''
	option capath ''
	option cert ''
	option certfile ''
	option ciphers ''
	option enabled ''
	option keyfile ''
	# topic namespace, a trailing slash is added when missing
	option topic_prefix 'apman/'
	# seconds between full status publishes
	option status_interval '10'
	# publish the raw 'iw dev <dev> station dump' text per device
	option station_dump '1'
	# subscribe the fleet wide '<topic_prefix>command' topic in addition to
	# the per host one
	option command_topic_global '1'
	# publish the global hostapd status (bss/radio/mld topology)
	option hostapd_status '1'
	# resend suppression: unchanged payloads are republished only after this
	# many seconds (retained properties / wireless status), and probes are
	# forwarded at most once per station and interval. 0 disables throttling
	#option property_republish '300'
	#option wireless_republish '60'
	#option probe_interval '10'
	# additional ubus objects whose notifications are forwarded
	list subscribe 'network.interface'
	list subscribe 'network.device'
	# ubus broadcast events that are forwarded
	list listen_event 'network.interface'
	# seconds between hostapd object list checks / settle delay before
	# resubscribing after a change. The fast interval is only used when
	# hostapd does not provide bss.* notifications
	#option ubus_check_interval '1'
	#option ubus_check_interval_slow '30'
	#option ubus_settle '5'
	# milliseconds between mosquitto loop ticks
	#option mqtt_loop_interval '200'
	# reconnect backoff bounds in seconds (jittered, per host)
	#option mqtt_retry_min '2'
	#option mqtt_retry_max '120'
	# hostapd control channel proxy: the command channel accepts
	# {"method":"ctrl","params":["","<ifname>","<COMMAND>"]} and answers with
	# the raw text plus the parsed key=value pairs. Reaches what ubus does not
	# offer — RELOAD_WPA_PSK, WPS_PIN with an argument, MIB counters.
	#option ctrl_enabled '1'
	#option ctrl_timeout '3'
	# only the commands on the built in allowlist are accepted; extend it
	# here or switch it off entirely. Without authentication in front of the
	# broker, ctrl_allow_all hands out everything hostapd can do.
	#list ctrl_allow 'DISASSOCIATE'
	#option ctrl_allow_all '0'
	# extra detail folded into the periodic status, fetched over the control
	# channel and cached: MIB counters per bss (4-way handshake failures,
	# radius client statistics) and the negotiated AKM/cipher per station.
	# Seconds between refreshes, 0 switches the collection off.
	#option mib_interval '60'
	#option sta_ctrl_interval '300'
	# forward the hostapd control channel event stream. It carries what ubus
	# does not: the keyid and vlan of a station at connect time, the numeric
	# status of a steering answer, why a client was refused, how the eap server
	# answered, and the acs/dfs/channel life cycle. Probe requests do not come
	# through here, so this is a quiet stream.
	#option ctrl_events '1'
	# only the built in list of events is forwarded; extend, remove, or take
	# everything hostapd emits
	#list ctrl_event_allow 'BEACON-RESP-RX'
	#list ctrl_event_deny 'PMKSA-CACHE-ADDED'
	#option ctrl_event_all '0'
