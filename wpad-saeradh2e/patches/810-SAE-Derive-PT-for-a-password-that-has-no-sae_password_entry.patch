From d48e92624da1066f318a4895448f734e7a73c025 Mon Sep 17 00:00:00 2001
From: André Valentin <avalentin@marcant.net>
Date: Fri, 28 Aug 2026 20:17:34 +0200
Subject: [PATCH] SAE: Derive PT for a password that has no sae_password_entry

sae_get_password() can return a password that does not come from a
struct sae_password_entry. When wpa_psk_radius is used, the password is
taken from the Tunnel-Password attribute delivered by the RADIUS server
and stored in sta->psk, and in that case both the returned
sae_password_entry pointer and the pre-computed PT are NULL.

auth_build_sae_commit() derived a PT on the fly only when a
sae_password_entry was available, so this case fell through to the
"SAE: No PT available" error and the exchange was aborted. As a result,
SAE with a password from RADIUS could be used only with the hunting and
pecking loop and not with hash-to-element, i.e., not with sae_pwe=1 or
sae_pwe=2 and not on the 6 GHz band where H2E is required.

Derive the PT from the returned password string instead of from the
sae_password_entry. This is a generalization of the previous behavior:
when an entry is present, password points to entry->password and the
derived PT is identical to the one derived before this change.

Signed-off-by: André Valentin <avalentin@marcant.net>

diff --git a/src/ap/ieee802_11.c b/src/ap/ieee802_11.c
index 2ce4940..c9af206 100644
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -995,15 +995,15 @@ static struct wpabuf * auth_build_sae_commit(struct hostapd_data *hapd,
 		struct sae_pt *tmp_pt = NULL;
 		bool failed = false;
 
-		if (!pt && pw) {
+		if (!pt && password) {
 			int groups[2] = { sta->sae->group, 0 };
 
 			wpa_printf(MSG_DEBUG,
-				   "SAE: Derive PT for encrypted PW ID");
+				   "SAE: Derive PT for the password");
 			tmp_pt = sae_derive_pt(groups, hapd->conf->ssid.ssid,
 					       hapd->conf->ssid.ssid_len,
-					       (const u8 *) pw->password,
-					       os_strlen(pw->password),
+					       (const u8 *) password,
+					       os_strlen(password),
 					       rx_id, rx_id_len);
 			if (!tmp_pt) {
 				wpa_printf(MSG_DEBUG,
