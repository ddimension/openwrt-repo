From 9597635238080501788cd1d1ad44ba6fa1c9ac3e Mon Sep 17 00:00:00 2001
From: André Valentin <avalentin@marcant.net>
Date: Fri, 28 Aug 2026 21:17:20 +0200
Subject: [PATCH] RADIUS: Allow an ACL query to carry an SAE Password Identifier

Prepare the RADIUS ACL query path for looking up a credential that is
named by an SAE Password Identifier instead of by the MAC address of the
station.

The RADIUS branch of hostapd_allowed_address() is moved into a new
hostapd_radius_acl_check() helper that takes an optional identifier, and
hostapd_acl_sae_password() is added as a second entry point into it. When
an identifier is given, it is used as the User-Name and User-Password of
the Access-Request; the station remains identified by the
Calling-Station-Id attribute that is already included. No new RADIUS
attribute is needed for this.

Both the cached ACL entries and the pending queries record the identifier
they were requested for, and the cache lookup and the duplicate query
check compare it, so that an entry that was fetched for an identifier is
never handed out for a station that did not use that identifier and vice
versa.

There is no functional change yet; nothing calls the new entry point.

Signed-off-by: André Valentin <avalentin@marcant.net>

diff --git a/src/ap/ieee802_11_auth.c b/src/ap/ieee802_11_auth.c
index 913a995..a9657ab 100644
--- a/src/ap/ieee802_11_auth.c
+++ b/src/ap/ieee802_11_auth.c
@@ -35,6 +35,10 @@ struct hostapd_cached_radius_acl {
 	int accepted; /* HOSTAPD_ACL_* */
 	struct hostapd_cached_radius_acl *next;
 	struct radius_sta info;
+	/* SAE Password Identifier this entry was requested for, if any. An
+	 * entry with an identifier must not be used for a station that did not
+	 * use that identifier and vice versa. */
+	char *pw_id;
 };
 
 
@@ -50,6 +54,7 @@ struct hostapd_acl_query_data {
 	u8 *anonce;
 	u8 *eapol;
 	size_t eapol_len;
+	char *pw_id;
 };
 
 
@@ -59,6 +64,7 @@ static void hostapd_acl_cache_free_entry(struct hostapd_cached_radius_acl *e)
 	os_free(e->info.identity);
 	os_free(e->info.radius_cui);
 	hostapd_free_psk_list(e->info.psk);
+	os_free(e->pw_id);
 	os_free(e);
 }
 
@@ -76,7 +82,7 @@ static void hostapd_acl_cache_free(struct hostapd_cached_radius_acl *acl_cache)
 
 
 static int hostapd_acl_cache_get(struct hostapd_data *hapd, const u8 *addr,
-				 struct radius_sta *out)
+				 const char *pw_id, struct radius_sta *out)
 {
 	struct hostapd_cached_radius_acl *entry;
 	struct os_reltime now;
@@ -87,6 +93,10 @@ static int hostapd_acl_cache_get(struct hostapd_data *hapd, const u8 *addr,
 		if (!ether_addr_equal(entry->addr, addr))
 			continue;
 
+		if ((entry->pw_id != NULL) != (pw_id != NULL) ||
+		    (pw_id && os_strcmp(entry->pw_id, pw_id) != 0))
+			continue;
+
 		if (os_reltime_expired(&now, &entry->timestamp,
 				       RADIUS_ACL_TIMEOUT))
 			return -1; /* entry has expired */
@@ -107,6 +117,7 @@ static void hostapd_acl_query_free(struct hostapd_acl_query_data *query)
 	os_free(query->auth_msg);
 	os_free(query->anonce);
 	os_free(query->eapol);
+	os_free(query->pw_id);
 	os_free(query);
 }
 
@@ -117,6 +128,7 @@ static int hostapd_radius_acl_query(struct hostapd_data *hapd, const u8 *addr,
 {
 	struct radius_msg *msg;
 	char buf[128];
+	const char *user;
 
 	query->radius_id = radius_client_get_id(hapd->radius);
 	msg = radius_msg_new(RADIUS_CODE_ACCESS_REQUEST, query->radius_id);
@@ -131,15 +143,25 @@ static int hostapd_radius_acl_query(struct hostapd_data *hapd, const u8 *addr,
 	if (!radius_msg_add_msg_auth(msg))
 		goto fail;
 
-	os_snprintf(buf, sizeof(buf), RADIUS_ADDR_FORMAT, MAC2STR(addr));
-	if (!radius_msg_add_attr(msg, RADIUS_ATTR_USER_NAME, (u8 *) buf,
-				 os_strlen(buf))) {
+	/* An SAE Password Identifier names the credential that is being asked
+	 * for, so use it as the User-Name. The station is identified with the
+	 * Calling-Station-Id attribute added below in that case. */
+	if (query->pw_id) {
+		user = query->pw_id;
+	} else {
+		os_snprintf(buf, sizeof(buf), RADIUS_ADDR_FORMAT,
+			    MAC2STR(addr));
+		user = buf;
+	}
+
+	if (!radius_msg_add_attr(msg, RADIUS_ATTR_USER_NAME, (const u8 *) user,
+				 os_strlen(user))) {
 		wpa_printf(MSG_DEBUG, "Could not add User-Name");
 		goto fail;
 	}
 
 	if (!radius_msg_add_attr_user_password(
-		    msg, (u8 *) buf, os_strlen(buf),
+		    msg, (const u8 *) user, os_strlen(user),
 		    hapd->conf->radius->auth_server->shared_secret,
 		    hapd->conf->radius->auth_server->shared_secret_len)) {
 		wpa_printf(MSG_DEBUG, "Could not add User-Password");
@@ -228,6 +250,105 @@ int hostapd_check_acl(struct hostapd_data *hapd, const u8 *addr,
 }
 
 
+#ifndef CONFIG_NO_RADIUS
+/* Look up a station (and optionally a specific SAE Password Identifier) from
+ * the RADIUS server. Returns HOSTAPD_ACL_PENDING if an Access-Request was sent;
+ * the queued frame is then processed again from hostapd_acl_recv_radius() once
+ * the server has replied. */
+static int hostapd_radius_acl_check(struct hostapd_data *hapd, const u8 *addr,
+				    const char *pw_id, const u8 *msg,
+				    size_t len, struct radius_sta *out)
+{
+	struct hostapd_acl_query_data *query;
+	int res;
+
+	/* Check whether ACL cache has an entry for this station */
+	res = hostapd_acl_cache_get(hapd, addr, pw_id, out);
+	if (res == HOSTAPD_ACL_ACCEPT || res == HOSTAPD_ACL_ACCEPT_TIMEOUT)
+		return res;
+	if (res == HOSTAPD_ACL_REJECT)
+		return HOSTAPD_ACL_REJECT;
+
+	for (query = hapd->acl_queries; query; query = query->next) {
+		if (!ether_addr_equal(query->addr, addr))
+			continue;
+		if ((query->pw_id != NULL) != (pw_id != NULL) ||
+		    (pw_id && os_strcmp(query->pw_id, pw_id) != 0))
+			continue;
+		/* pending query in RADIUS retransmit queue; do not generate a
+		 * new one */
+		return HOSTAPD_ACL_PENDING;
+	}
+
+	if (!hapd->conf->radius->auth_server)
+		return HOSTAPD_ACL_REJECT;
+
+	/* No entry in the cache - query external RADIUS server */
+	query = os_zalloc(sizeof(*query));
+	if (!query) {
+		wpa_printf(MSG_ERROR, "malloc for query data failed");
+		return HOSTAPD_ACL_REJECT;
+	}
+	os_get_reltime(&query->timestamp);
+	os_memcpy(query->addr, addr, ETH_ALEN);
+	if (pw_id) {
+		query->pw_id = os_strdup(pw_id);
+		if (!query->pw_id) {
+			hostapd_acl_query_free(query);
+			return HOSTAPD_ACL_REJECT;
+		}
+	}
+	if (hostapd_radius_acl_query(hapd, addr, query)) {
+		wpa_printf(MSG_DEBUG,
+			   "Failed to send Access-Request for ACL query.");
+		hostapd_acl_query_free(query);
+		return HOSTAPD_ACL_REJECT;
+	}
+
+	query->auth_msg = os_memdup(msg, len);
+	if (!query->auth_msg) {
+		wpa_printf(MSG_ERROR,
+			   "Failed to allocate memory for auth frame.");
+		hostapd_acl_query_free(query);
+		return HOSTAPD_ACL_REJECT;
+	}
+	query->auth_msg_len = len;
+	query->next = hapd->acl_queries;
+	hapd->acl_queries = query;
+
+	/* Queued data will be processed in hostapd_acl_recv_radius()
+	 * when RADIUS server replies to the sent Access-Request. */
+	return HOSTAPD_ACL_PENDING;
+}
+
+
+/**
+ * hostapd_acl_sae_password - Request an SAE password from the RADIUS server
+ * @hapd: hostapd BSS data
+ * @addr: MAC address of the STA
+ * @pw_id: SAE Password Identifier the STA used
+ * @msg: Authentication frame to process again once the reply has been received
+ * @len: Length of msg in octets
+ * @out: Buffer for returning the RADIUS attributes
+ * Returns: HOSTAPD_ACL_ACCEPT, HOSTAPD_ACL_REJECT, or HOSTAPD_ACL_PENDING
+ *
+ * The caller is responsible for properly cloning the returned out->identity and
+ * out->radius_cui and out->psk values.
+ */
+int hostapd_acl_sae_password(struct hostapd_data *hapd, const u8 *addr,
+			     const char *pw_id, const u8 *msg, size_t len,
+			     struct radius_sta *out)
+{
+	os_memset(out, 0, sizeof(*out));
+
+	if (!pw_id)
+		return HOSTAPD_ACL_REJECT;
+
+	return hostapd_radius_acl_check(hapd, addr, pw_id, msg, len, out);
+}
+#endif /* CONFIG_NO_RADIUS */
+
+
 /**
  * hostapd_allowed_address - Check whether a specified STA can be authenticated
  * @hapd: hostapd BSS data
@@ -263,8 +384,6 @@ int hostapd_allowed_address(struct hostapd_data *hapd, const u8 *addr,
 #ifdef CONFIG_NO_RADIUS
 		return HOSTAPD_ACL_REJECT;
 #else /* CONFIG_NO_RADIUS */
-		struct hostapd_acl_query_data *query;
-
 		if (is_probe_req) {
 			/* Skip RADIUS queries for Probe Request frames to avoid
 			 * excessive load on the authentication server. */
@@ -274,56 +393,8 @@ int hostapd_allowed_address(struct hostapd_data *hapd, const u8 *addr,
 		if (hapd->conf->ssid.dynamic_vlan == DYNAMIC_VLAN_DISABLED)
 			os_memset(&out->vlan_id, 0, sizeof(out->vlan_id));
 
-		/* Check whether ACL cache has an entry for this station */
-		res = hostapd_acl_cache_get(hapd, addr, out);
-		if (res == HOSTAPD_ACL_ACCEPT ||
-		    res == HOSTAPD_ACL_ACCEPT_TIMEOUT)
-			return res;
-		if (res == HOSTAPD_ACL_REJECT)
-			return HOSTAPD_ACL_REJECT;
-
-		query = hapd->acl_queries;
-		while (query) {
-			if (ether_addr_equal(query->addr, addr)) {
-				/* pending query in RADIUS retransmit queue;
-				 * do not generate a new one */
-				return HOSTAPD_ACL_PENDING;
-			}
-			query = query->next;
-		}
-
-		if (!hapd->conf->radius->auth_server)
-			return HOSTAPD_ACL_REJECT;
-
-		/* No entry in the cache - query external RADIUS server */
-		query = os_zalloc(sizeof(*query));
-		if (!query) {
-			wpa_printf(MSG_ERROR, "malloc for query data failed");
-			return HOSTAPD_ACL_REJECT;
-		}
-		os_get_reltime(&query->timestamp);
-		os_memcpy(query->addr, addr, ETH_ALEN);
-		if (hostapd_radius_acl_query(hapd, addr, query)) {
-			wpa_printf(MSG_DEBUG,
-				   "Failed to send Access-Request for ACL query.");
-			hostapd_acl_query_free(query);
-			return HOSTAPD_ACL_REJECT;
-		}
-
-		query->auth_msg = os_memdup(msg, len);
-		if (!query->auth_msg) {
-			wpa_printf(MSG_ERROR,
-				   "Failed to allocate memory for auth frame.");
-			hostapd_acl_query_free(query);
-			return HOSTAPD_ACL_REJECT;
-		}
-		query->auth_msg_len = len;
-		query->next = hapd->acl_queries;
-		hapd->acl_queries = query;
-
-		/* Queued data will be processed in hostapd_acl_recv_radius()
-		 * when RADIUS server replies to the sent Access-Request. */
-		return HOSTAPD_ACL_PENDING;
+		return hostapd_radius_acl_check(hapd, addr, NULL, msg, len,
+						out);
 #endif /* CONFIG_NO_RADIUS */
 	}
 
@@ -532,6 +603,13 @@ hostapd_acl_recv_radius(struct radius_msg *msg, struct radius_msg *req,
 	}
 	os_get_reltime(&cache->timestamp);
 	os_memcpy(cache->addr, query->addr, sizeof(cache->addr));
+	if (query->pw_id) {
+		cache->pw_id = os_strdup(query->pw_id);
+		if (!cache->pw_id) {
+			os_free(cache);
+			goto done;
+		}
+	}
 	info = &cache->info;
 	if (hdr->code == RADIUS_CODE_ACCESS_ACCEPT) {
 		u8 *buf;
diff --git a/src/ap/ieee802_11_auth.h b/src/ap/ieee802_11_auth.h
index 22ae1a9..ae480d9 100644
--- a/src/ap/ieee802_11_auth.h
+++ b/src/ap/ieee802_11_auth.h
@@ -39,5 +39,10 @@ void hostapd_copy_psk_list(struct hostapd_sta_wpa_psk_short **psk,
 void hostapd_acl_req_radius_psk(struct hostapd_data *hapd, const u8 *addr,
 				int key_mgmt, const u8 *anonce,
 				const u8 *eapol, size_t eapol_len);
+#ifndef CONFIG_NO_RADIUS
+int hostapd_acl_sae_password(struct hostapd_data *hapd, const u8 *addr,
+			     const char *pw_id, const u8 *msg, size_t len,
+			     struct radius_sta *out);
+#endif /* CONFIG_NO_RADIUS */
 
 #endif /* IEEE802_11_AUTH_H */
