From 09d43f8c6fbdb9b51766a4fb89131b4b4d7534d7 Mon Sep 17 00:00:00 2001
From: André Valentin <avalentin@marcant.net>
Date: Fri, 28 Aug 2026 21:54:40 +0200
Subject: [PATCH] AP: Report the SAE Password Identifier in STA info

The Password Identifier a station used is already stored in
sta->sae_pw_id when the SAE exchange completes, but it was not reported
anywhere. Add it as an sae_password_id field to the STA info of the
control interface and to the AP-STA-CONNECTED event.

This names the credential in the same way the keyid of a wpa_psk_file
entry does for WPA-PSK, both for locally configured identifiers and for
identifiers that were looked up from a RADIUS server. The identifier is
received from the station and is printf_encode()d for that reason.

Signed-off-by: André Valentin <avalentin@marcant.net>

diff --git a/src/ap/ctrl_iface_ap.c b/src/ap/ctrl_iface_ap.c
index 18a79f1..bcc6fd2 100644
--- a/src/ap/ctrl_iface_ap.c
+++ b/src/ap/ctrl_iface_ap.c
@@ -474,6 +474,18 @@ static int hostapd_ctrl_iface_sta_mib(struct hostapd_data *hapd,
 			len += ret;
 	}
 
+	if (sta->sae_pw_id) {
+		char pw_id[4 * 255 + 1];
+
+		printf_encode(pw_id, sizeof(pw_id),
+			      wpabuf_head(sta->sae_pw_id),
+			      wpabuf_len(sta->sae_pw_id));
+		ret = os_snprintf(buf + len, buflen - len,
+				  "sae_password_id=%s\n", pw_id);
+		if (!os_snprintf_error(buflen - len, ret))
+			len += ret;
+	}
+
 	dpp_pkhash = ap_sta_wpa_get_dpp_pkhash(hapd, sta);
 	if (dpp_pkhash) {
 		ret = os_snprintf(buf + len, buflen - len, "dpp_pkhash=");
diff --git a/src/ap/sta_info.c b/src/ap/sta_info.c
index 367dc57..0c9ffbb 100644
--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -1823,12 +1823,14 @@ void ap_sta_set_authorized_event(struct hostapd_data *hapd,
 		char vlanid_buf[20];
 		char alg_buf[100];
 		char identity_buf[4 * 255 + 16];
+		char pw_id_buf[4 * 255 + 24];
 
 		dpp_pkhash_buf[0] = '\0';
 		keyid_buf[0] = '\0';
 		ip_addr[0] = '\0';
 		vlanid_buf[0] = '\0';
 		identity_buf[0] = '\0';
+		pw_id_buf[0] = '\0';
 		alg_buf[0] = '\0';
 
 #ifdef CONFIG_P2P
@@ -1869,6 +1871,21 @@ void ap_sta_set_authorized_event(struct hostapd_data *hapd,
 				    sizeof(identity_buf) - plen, "\"");
 		}
 
+		if (sta->sae_pw_id) {
+			size_t plen;
+
+			os_strlcpy(pw_id_buf, " sae_password_id=\"",
+				   sizeof(pw_id_buf));
+			plen = os_strlen(pw_id_buf);
+			printf_encode(pw_id_buf + plen,
+				      sizeof(pw_id_buf) - plen - 1,
+				      wpabuf_head(sta->sae_pw_id),
+				      wpabuf_len(sta->sae_pw_id));
+			plen = os_strlen(pw_id_buf);
+			os_snprintf(pw_id_buf + plen,
+				    sizeof(pw_id_buf) - plen, "\"");
+		}
+
 		dpp_pkhash = ap_sta_wpa_get_dpp_pkhash(hapd, sta);
 		if (dpp_pkhash) {
 			const char *prefix = " dpp_pkhash=";
@@ -1889,17 +1906,17 @@ void ap_sta_set_authorized_event(struct hostapd_data *hapd,
 
 		hostapd_ubus_notify_authorized(hapd, sta, auth_alg);
 		wpa_msg(hapd->msg_ctx, MSG_INFO,
-			AP_STA_CONNECTED "%s%s%s%s%s%s%s",
+			AP_STA_CONNECTED "%s%s%s%s%s%s%s%s",
 			buf, ip_addr, keyid_buf, dpp_pkhash_buf, vlanid_buf,
-			alg_buf, identity_buf);
+			alg_buf, identity_buf, pw_id_buf);
 
 		if (hapd->msg_ctx_parent &&
 		    hapd->msg_ctx_parent != hapd->msg_ctx)
 			wpa_msg_no_global(hapd->msg_ctx_parent, MSG_INFO,
-					  AP_STA_CONNECTED "%s%s%s%s%s%s%s",
+					  AP_STA_CONNECTED "%s%s%s%s%s%s%s%s",
 					  buf, ip_addr, keyid_buf,
 					  dpp_pkhash_buf, vlanid_buf, alg_buf,
-					  identity_buf);
+					  identity_buf, pw_id_buf);
 	} else {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, AP_STA_DISCONNECTED "%s", buf);
 		hostapd_ubus_notify(hapd, "disassoc", sta->addr);
