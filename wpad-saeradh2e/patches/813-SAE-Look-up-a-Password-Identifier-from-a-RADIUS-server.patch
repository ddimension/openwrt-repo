From 2acdfc5991a1471ea26f18381a4c06d256aef8a4 Mon Sep 17 00:00:00 2001
From: André Valentin <avalentin@marcant.net>
Date: Fri, 28 Aug 2026 21:36:35 +0200
Subject: [PATCH] SAE: Look up a Password Identifier from a RADIUS server

Add a sae_password_radius option that lets an AP serve SAE Password
Identifiers that are not configured locally. This is useful for
deployments where the credentials are managed centrally and the station
is not known by its MAC address before it authenticates, which is
precisely the case a Password Identifier is meant to cover.

When a station uses an identifier for which no sae_password or
sae_password_file entry matches, processing of the SAE Commit message is
suspended and an Access-Request is sent for that identifier. The frame is
processed again once the RADIUS server has replied, in the same way as an
Access-Request for a MAC address based ACL check. The lookup is done
after the anti-clogging token check so that a station that is only going
to be asked for a token does not cause a request to the server.

The password from the Tunnel-Password attribute is stored separately from
sta->psk since that field is replaced whenever MAC address based RADIUS
information is applied to the station, which would otherwise discard the
password that was fetched for the identifier.

hostapd_sae_pw_id_in_use() reports identifiers as being both in use and
not exclusively in use when this option is enabled. Password identifiers
require hash-to-element, so H2E has to be available, but stations that do
not use an identifier may still be served from another source and must
keep working, so the BSS is not restricted to H2E only.

Signed-off-by: André Valentin <avalentin@marcant.net>

diff --git a/hostapd/config_file.c b/hostapd/config_file.c
index 1ed3dee..829a120 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -4640,6 +4640,8 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 		}
 	} else if (os_strcmp(buf, "sae_password_psk") == 0) {
 		bss->sae_password_psk = atoi(pos);
+	} else if (os_strcmp(buf, "sae_password_radius") == 0) {
+		bss->sae_password_radius = atoi(pos);
 	} else if (os_strcmp(buf, "sae_track_password") == 0) {
 		bss->sae_track_password = atoi(pos);
 #endif /* CONFIG_SAE */
diff --git a/hostapd/hostapd.conf b/hostapd/hostapd.conf
index b81ce11..47429f5 100644
--- a/hostapd/hostapd.conf
+++ b/hostapd/hostapd.conf
@@ -2207,6 +2207,25 @@ own_ip_addr=127.0.0.1
 # 1 = disabled in all cases
 #sae_password_psk=0
 
+# Request SAE passwords by Password Identifier from a RADIUS server
+# 0 = disabled (default)
+# 1 = enabled
+#
+# When enabled and a station uses an SAE Password Identifier for which no
+# sae_password/sae_password_file entry is configured, an Access-Request is sent
+# with the identifier as the User-Name and the MAC address of the station in the
+# Calling-Station-Id attribute. Like in the macaddr_acl=2 case, the User-Name
+# value is also used as the User-Password of the request. The password is taken
+# from the Tunnel-Password attribute of the Access-Accept, which must contain
+# the 8..63 character passphrase; a 64 character hex encoded PSK cannot be used
+# with SAE. This requires a RADIUS authentication server to be configured.
+#
+# Password identifiers require hash-to-element, so enabling this makes hostapd
+# advertise and accept H2E. Stations that do not use an identifier are not
+# affected and can continue to use the hunting and pecking loop, i.e., this does
+# not restrict the BSS to H2E only.
+#sae_password_radius=0
+
 # Tracking of SAE password use
 # While SAE design does not allow the AP to determine the used password robustly
 # if multiple password are configured without use of password identifiers, a
diff --git a/src/ap/ap_config.c b/src/ap/ap_config.c
index 2ee46df..cbbfc60 100644
--- a/src/ap/ap_config.c
+++ b/src/ap/ap_config.c
@@ -1760,6 +1760,16 @@ int hostapd_sae_pw_id_in_use(struct hostapd_bss_config *conf)
 	if (conf->ssid.wpa_passphrase)
 		without_id = 1;
 
+	/* With sae_password_radius, the identifiers are not known locally, but
+	 * they are used, so H2E has to be available for them. Stations that do
+	 * not use an identifier may still be served from another source, so
+	 * count both cases to keep the hunting and pecking loop available for
+	 * them instead of restricting the BSS to H2E only. */
+	if (conf->sae_password_radius) {
+		with_id = 1;
+		without_id = 1;
+	}
+
 	for (pw = conf->sae_passwords; pw; pw = pw->next) {
 		if (pw->identifier)
 			with_id = 1;
diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index 3c39a28..a0a8cea 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -683,6 +683,7 @@ struct hostapd_bss_config {
 	int *sae_groups;
 	struct sae_password_entry *sae_passwords;
 	int sae_password_psk;
+	int sae_password_radius;
 	int sae_track_password;
 	struct wpabuf *sae_pw_id_key;
 	unsigned int sae_pw_id_num;
diff --git a/src/ap/ieee802_11.c b/src/ap/ieee802_11.c
index c9af206..3ea407e 100644
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -866,6 +866,19 @@ use_sta_psk:
 		}
 	}
 
+	/* A password that was requested from the RADIUS server for the
+	 * Password Identifier this STA used. */
+	if (!password && sta && rx_id && sta->sae_radius_pw_id &&
+	    os_strlen(sta->sae_radius_pw_id) == rx_id_len &&
+	    os_memcmp(sta->sae_radius_pw_id, rx_id, rx_id_len) == 0) {
+		for (psk = sta->sae_radius_psk; psk; psk = psk->next) {
+			if (psk->is_passphrase) {
+				password = psk->passphrase;
+				break;
+			}
+		}
+	}
+
 	/* Try to decrypt the received password identifier if no plaintext
 	 * identifier match was found. */
 	if (!password && rx_id && rx_id_len > 4 + 4 + AES_BLOCK_SIZE &&
@@ -1780,6 +1793,80 @@ static int check_sae_rejected_groups(struct hostapd_data *hapd,
 }
 
 
+#ifndef CONFIG_NO_RADIUS
+/* Ask the RADIUS server for the password that belongs to the Password
+ * Identifier the STA used, if it is not configured locally. Returns 1 if an
+ * Access-Request is pending and the frame will be processed again once the
+ * reply has been received, 0 if processing can continue, and -1 on error. */
+static int sae_radius_password_query(struct hostapd_data *hapd,
+				     struct sta_info *sta,
+				     const struct ieee80211_mgmt *mgmt,
+				     size_t len)
+{
+	struct radius_sta rad_info;
+	const u8 *rx_id;
+	size_t rx_id_len;
+	char *pw_id;
+	int res;
+
+	if (!hapd->conf->sae_password_radius || !sta->sae || !sta->sae->tmp)
+		return 0;
+
+	rx_id = sta->sae->tmp->parsed_pw_id;
+	rx_id_len = sta->sae->tmp->parsed_pw_id_len;
+	if (!rx_id || !rx_id_len)
+		return 0;
+
+	/* Already requested for this identifier */
+	if (sta->sae_radius_pw_id &&
+	    os_strlen(sta->sae_radius_pw_id) == rx_id_len &&
+	    os_memcmp(sta->sae_radius_pw_id, rx_id, rx_id_len) == 0)
+		return 0;
+
+	/* A locally configured password takes precedence */
+	if (sae_get_password(hapd, sta, rx_id, rx_id_len, NULL, NULL, NULL))
+		return 0;
+
+	pw_id = os_malloc(rx_id_len + 1);
+	if (!pw_id)
+		return -1;
+	os_memcpy(pw_id, rx_id, rx_id_len);
+	pw_id[rx_id_len] = '\0';
+
+	res = hostapd_acl_sae_password(hapd, sta->addr, pw_id,
+				       (const u8 *) mgmt, len, &rad_info);
+	if (res == HOSTAPD_ACL_PENDING) {
+		wpa_printf(MSG_DEBUG,
+			   "SAE: Waiting for RADIUS reply for id '%s' from "
+			   MACSTR, pw_id, MAC2STR(sta->addr));
+		os_free(pw_id);
+		/* The Authentication frame is processed again once the RADIUS
+		 * server has replied. handle_auth() has already recorded the
+		 * sequence number of this frame, so forget it to make sure the
+		 * duplicated processing is not dropped as a retransmission. */
+		sta->last_seq_ctrl = WLAN_INVALID_MGMT_SEQ;
+		return 1;
+	}
+
+	if (res != HOSTAPD_ACL_ACCEPT && res != HOSTAPD_ACL_ACCEPT_TIMEOUT) {
+		wpa_printf(MSG_DEBUG,
+			   "SAE: No RADIUS password for id '%s'",
+			   pw_id);
+		os_free(pw_id);
+		return 0;
+	}
+
+	hostapd_free_psk_list(sta->sae_radius_psk);
+	sta->sae_radius_psk = NULL;
+	hostapd_copy_psk_list(&sta->sae_radius_psk, rad_info.psk);
+	os_free(sta->sae_radius_pw_id);
+	sta->sae_radius_pw_id = pw_id;
+
+	return 0;
+}
+#endif /* CONFIG_NO_RADIUS */
+
+
 static void handle_auth_sae(struct hostapd_data *hapd, struct sta_info *sta,
 			    const struct ieee80211_mgmt *mgmt, size_t len,
 			    u16 auth_transaction, u16 status_code)
@@ -1792,6 +1879,9 @@ static void handle_auth_sae(struct hostapd_data *hapd, struct sta_info *sta,
 	const u8 *pos, *end;
 	int sta_removed = 0;
 	bool success_status;
+#ifndef CONFIG_NO_RADIUS
+	int res;
+#endif /* CONFIG_NO_RADIUS */
 
 	if (!groups) {
 		groups = default_groups;
@@ -2033,6 +2123,19 @@ static void handle_auth_sae(struct hostapd_data *hapd, struct sta_info *sta,
 			goto reply;
 		}
 
+#ifndef CONFIG_NO_RADIUS
+		res = sae_radius_password_query(hapd, sta, mgmt, len);
+		if (res < 0) {
+			resp = WLAN_STATUS_UNSPECIFIED_FAILURE;
+			goto reply;
+		}
+		if (res > 0) {
+			/* The Authentication frame is processed again once the
+			 * RADIUS server has replied. */
+			return;
+		}
+#endif /* CONFIG_NO_RADIUS */
+
 		resp = sae_sm_step(hapd, sta, auth_transaction,
 				   status_code, allow_reuse, &sta_removed);
 	} else if (auth_transaction == WLAN_AUTH_TR_SEQ_SAE_CONFIRM) {
diff --git a/src/ap/sta_info.c b/src/ap/sta_info.c
index faf4ec3..426e16f 100644
--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -487,6 +487,8 @@ void ap_free_sta(struct hostapd_data *hapd, struct sta_info *sta)
 	os_free(sta->he_6ghz_capab);
 	os_free(sta->eht_capab);
 	hostapd_free_psk_list(sta->psk);
+	hostapd_free_psk_list(sta->sae_radius_psk);
+	os_free(sta->sae_radius_pw_id);
 	os_free(sta->identity);
 	os_free(sta->radius_cui);
 	os_free(sta->t_c_url);
diff --git a/src/ap/sta_info.h b/src/ap/sta_info.h
index 63d99f1..bda6adc 100644
--- a/src/ap/sta_info.h
+++ b/src/ap/sta_info.h
@@ -363,6 +363,12 @@ struct sta_info {
 	struct wpabuf *sae_pw_id;
 	unsigned int sae_pw_id_counter;
 
+	/* Password received from the RADIUS server for sae_radius_pw_id. This
+	 * is kept separate from psk since that one is replaced whenever the
+	 * MAC address based RADIUS information is applied to the STA. */
+	struct hostapd_sta_wpa_psk_short *sae_radius_psk;
+	char *sae_radius_pw_id;
+
 #ifdef CONFIG_IEEE8021X_AUTH
 	struct eap_over_auth_data eap_auth_data;
 #endif /* CONFIG_IEEE8021X_AUTH */
