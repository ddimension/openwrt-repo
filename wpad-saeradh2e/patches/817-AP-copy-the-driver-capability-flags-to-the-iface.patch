From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andre Valentin <avalentin@marcant.net>
Subject: [PATCH] AP: copy the driver capability flags to the interface

diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -2999,6 +2999,20 @@
 
 	if (!iface->conf)
 		return -1;
+	/*
+	 * The capability flags live on the driver's private struct; the
+	 * interface copy is what the reduced neighbor report colocation check
+	 * and the DFS handling read, and nothing fills it. Measured on
+	 * ap-av-grwz: mt7915e advertises WIPHY_FLAG_HAS_CHANNEL_SWITCH, yet
+	 * the lower band beacons carried no RNR for the co-located 6 GHz bss.
+	 */
+	if (iface->bss[0]->driver->get_capa) {
+		struct wpa_driver_capa capa;
+
+		if (iface->bss[0]->driver->get_capa(iface->bss[0]->drv_priv,
+					    &capa) == 0)
+			iface->drv_flags = capa.flags;
+	}
 	ret = setup_interface(iface);
 	if (ret) {
 		wpa_printf(MSG_ERROR, "%s: Unable to setup interface.",
